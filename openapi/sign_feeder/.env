# Global settings. Every package's .env inherits these.
DEVICE_HOST=http://fenster-matrix.hackhro

# Playlist order (package folder names). Unlisted packages follow alphabetically.
ORDER=de.hackhro.brightness,de.hackhro.rsag_monitor,de.hackhro.open,de.warnowvally.houselab,de.hackhro.event

# Max seconds a package's preload may take before its slide is skipped.
PRELOAD_TIMEOUT=15
# Pause when a whole round showed nothing (sign / network down).
IDLE_SECONDS=10
# Upload each package's anim.json + assets/ to the sign on start.
UPLOAD_ON_START=false
