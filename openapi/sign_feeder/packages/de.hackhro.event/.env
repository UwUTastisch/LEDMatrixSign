# Seconds per event slide.
DURATION=15
# iCal (.ics) URL of the event calendar. Empty = no event slides.
EVENTS_URL=
# The calendar doesn't change often — fetch at most every 10 minutes.
CACHE_SECONDS=600
MIN_EVENTS=1
MAX_SHOWN=3
LOOKAHEAD_DAYS=14
# {placeholder} names used in this package's anim.json
PARAM_TEXT=event_text
PARAM_DATE=date
PARAM_WHERE=where
