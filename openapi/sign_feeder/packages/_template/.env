# Seconds to hold each slide (0 = side effect only, e.g. brightness).
DURATION=10
# Reuse the last preload result for this long (0 = fetch every round).
CACHE_SECONDS=0
# Set to false to skip this package without deleting it.
ENABLED=true
# Optional: several instances of this package, keys go to ctx.args.
# INSTANCES='[{"label": "a", "foo": 1}, {"label": "b", "foo": 2, "duration": 5}]'
TEXT=Hallo Welt
